# SETUP/.env — FTPS credentials for SETUP/deploy.py. Copy this file to SETUP/.env
# (gitignored) and fill it in, or export the same names in the environment, which
# wins over the file. CI passes them as environment variables from its secrets.
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=
# Deploy stamp (SETUP/deploy/mqtt_stamp.py): skipped unless TWIST_MQTT_HOST is set.
TWIST_MQTT_HOST=
TWIST_MQTT_PORT=
TWIST_MQTT_USER=
TWIST_MQTT_PASS=
# Runtime config written next to the bundle as dist/spog-config.js (SETUP/deploy/runtime_config.py).
SPOG_BROKER=
SPOG_BUS_KEY=
